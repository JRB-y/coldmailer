PORT=4000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/coldmailer

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Backend URL (for OAuth callbacks)
BACKEND_URL=http://localhost:4000

# Google OAuth (optional - for Google Sign-In)
# Get your credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Future configurations:
# STRIPE_SECRET_KEY=

# WHOIS API Configuration (for domain age checking)
# Get your API key from https://apilayer.com/
WHOIS_API_URL=your-api-layer-key-here
WHOIS_API_URL=https://api.apilayer.com/whois/query

# Ollama Configuration (for AI chat assistant)
# Make sure Ollama is running locally on port 11434
# Download from https://ollama.com/
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2